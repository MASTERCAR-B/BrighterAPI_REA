# Copy to .env (gitignored) and fill in your paid Brighter Data account credentials.
# BrighterClient authenticates directly via AWS Cognito SRP-6a and auto-refreshes tokens.
BRIGHTER_EMAIL=you@example.com
BRIGHTER_PASSWORD=your_password_here

# Optional: pass a pre-fetched Cognito IdToken instead of email/password
# BRIGHTER_ID_TOKEN=

# Optional defaults for server.py
BD_ASSET=BTCUSD
BD_TF=1D
